# 1. App Login Password (Personal Mode - Phase 1)
# Leave empty for unlocked local dev; set a strong password in production.
APP_PASSWORD="change-me-1234"

# 2. 32+ Character Secret for Encrypting BYOK API Keys (AES-256-GCM)
ENCRYPTION_SECRET="replace-with-a-random-32-character-secret-key"

# 3. Database Connection (Defaults to file:./data/local.db locally; use Turso URL for cloud sync)
DATABASE_URL="file:./data/local.db"
DATABASE_AUTH_TOKEN=""

# 4. Optional System Default AI Keys (You can also add BYOK keys inside Settings)
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# 5. Built-in Free Tier Limits (For users without an API key)
FREE_MONTHLY_AI_LIMIT="15"
MONTHLY_SYSTEM_BUDGET_USD="2.00"
