# 1. Uygulama Giriş Şifresi (Kişisel Sürüm - Faz 1)
# Boş bırakılırsa yerel geliştirme modunda şifresiz açılır, bulutta mutlaka belirleyin.
APP_PASSWORD="change-me-1234"

# 2. BYOK Anahtarlarını Şifrelemek İçin 32+ Karakterlik Gizli Anahtar (AES-256-GCM)
ENCRYPTION_SECRET="replace-with-a-random-32-character-secret-key"

# 3. Veritabanı Bağlantısı (Yerelde sıfır kurulum için file:./data/local.db kullanılır; telefon+PC senkronizasyonu için Turso URL girilir)
DATABASE_URL="file:./data/local.db"
DATABASE_AUTH_TOKEN=""

# 4. Sistem Varsayılan AI Anahtarları (İsteğe bağlı - Uygulama içinden BYOK olarak da girilebilir)
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# 5. Sistem Varsayılan Aylık Maliyet Sigortası (USD)
MONTHLY_SYSTEM_BUDGET_USD="2.00"
