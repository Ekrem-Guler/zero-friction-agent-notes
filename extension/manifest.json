{
  "manifest_version": 3,
  "name": "ZeroNote Quick Capture",
  "version": "1.0.0",
  "description": "Zero-friction quick note capture for ZeroNote. Press Alt+N, type, hit Enter, done.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zeronote-quick-capture@ekremguler.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZeroNote Quick Capture (Alt+N)",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Open ZeroNote quick capture"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ]
}
